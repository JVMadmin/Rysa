# ==================================================================
# RYSA Consultor de Precios - variables de entorno (Docker)
# Copia como .env.docker.price-checker y ajusta los valores.
# La base de datos es la misma PostgreSQL del ERP (acceso SOLO LECTURA).
# ==================================================================

# Red Docker del ERP ya debe existir (`docker compose up -d` del ERP primero:
# crea la red `rys a_net` y el contenedor `rysa_postgres`).

# --- Acceso a PostgreSQL (mismas credenciales/DB del ERP) ---
PRICE_DATABASE_URL=postgresql+asyncpg://rysa:rysa_dev_only_change_me@rysa_postgres:5432/rysa_dev

# Token opcional de la API del consultor (header X-Price-Token).
# Vacío = sin restricción (solo datos públicos). Si lo configuras, el compose
# lo inyecta automáticamente en el build del kiosco (REACT_APP_PRICE_TOKEN),
# así que NO hace falta ninguna variable adicional del lado del dispositivo.
PRICE_API_TOKEN=

# Origen publico del ERP para resolver imágenes (p. ej. https://erp.gruporysa.com
# o http://servidor-local:8080). Déjalo vacío si las imágenes ya son absolutas.
PRICE_IMG_BASE=

# CORS permitido por la API (lista separada por comas o *). En produccion
# restringelo al origen del dispositivo (p. ej. https://precios.gruporysa.com).
PRICE_ALLOWED_ORIGINS=*

# Puerto en el que se publica el Consultor (host).
PRICE_HTTP_PORT=8081

# Nombre de sucursal que se muestra en el encabezado del kiosco (opcional).
PRICE_SUCURSAL=Sucursal Centro