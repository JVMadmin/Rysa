# ============================================================
# RYSA - Nginx con TLS (LISTO PARA CERTBOT)
# ============================================================
# ACTIVACIÓN en el VPS (con dominio apuntando al servidor):
#
#   1) Emitir certificado (standalone o webroot):
#        sudo certbot certonly --standalone -d erp.gruporysa.com
#
#   2) En docker-compose.yml del ERP, montar certs y exponer 443:
#        nginx:
#          ports:
#            - "80:80"
#            - "443:443"
#          volumes:
#            - /etc/letsencrypt:/etc/letsencrypt:ro
#
#   3) Reemplazar la config actual:
#        cp docker/nginx/default.conf docker/nginx/default.conf.http
#        cp docker/nginx/default.conf.tls docker/nginx/default.conf
#        # editar server_name y luego:
#        docker compose up -d --force-recreate nginx
#
#   4) Renovación automática (cron mensual):
#        certbot renew --quiet && docker compose restart nginx
#
# NOTA: el backend sirve cookies con Secure solo cuando ENVIRONMENT=production;
# con TLS activo asegúrate de que ENVIRONMENT=production en el .env.
# ============================================================

server {
    listen 80;
    server_name erp.gruporysa.com;

    # Reto ACME para renovaciones de certbot.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Todo el resto va a HTTPS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name erp.gruporysa.com;

    ssl_certificate     /etc/letsencrypt/live/erp.gruporysa.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp.gruporysa.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Seguridad (HSTS solo después de confirmar que HTTPS es estable).
    add_header Strict-Transport-Security "max-age=15552000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'self'; base-uri 'self';" always;

    client_max_body_size 350m;
    client_body_timeout 120s;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    resolver 127.0.0.11 valid=10s;

    # --- Frontend React ---
    location / {
        set $frontend_upstream http://frontend:80;
        proxy_pass $frontend_upstream;
        proxy_http_version 1.1;
    }

    # --- Backend FastAPI ---
    location /api/ {
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # --- Archivos subidos servidos por el backend ---
    location /uploads/ {
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
