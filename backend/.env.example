# Grupo RYSA backend - Plantilla de variables de entorno
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA subas `.env` real al repositorio.

# Entorno activo: development | production
ENVIRONMENT=development

# Conexión MongoDB (bases separadas por entorno: rysa_dev / rysa_prod)
MONGO_URL=mongodb://localhost:27017/rysa_dev
DB_NAME=rysa_dev

# Clave secreta para firmar los tokens JWT.
# GENERA LA TUYA con:  openssl rand -hex 32
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Orígenes CORS permitidos (separados por coma). Vacío usa los valores por defecto.
CORS_ORIGINS=

# Directorio local donde se guardan imágenes y tickets PDF
UPLOAD_DIR=uploads

# Credenciales del admin inicial (SOLO se usa en desarrollo, ver server.py)
ADMIN_EMAIL=admin@gruporysa.com
ADMIN_PASSWORD=cambia-la-contrasena-del-admin
ADMIN_NAME=Admin