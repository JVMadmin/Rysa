# Grupo RYSA backend - Plantilla de variables de entorno
# Copia este archivo a `.env` (local) o úsalo como referencia para definir las
# variables en el VPS (systemd/docker). NUNCA subas `.env` real al repositorio.
# Los secretos se inyectan SIEMPRE mediante variables de entorno, nunca por código.

# Entorno activo: development | production
ENVIRONMENT=development

# Módulo DESARROLLADOR (herramientas de limpieza/reset).
# true solo en desarrollo/pruebas. En producción DEBE ser false:
# las rutas destructivas ni siquiera se registran.
DEVELOPER_MODE=true

# Conexión PostgreSQL (única base de datos soportada).
# En producción el host/credenciales apuntan al servidor real.
DATABASE_URL=postgresql+asyncpg://rysa_user:<PASSWORD>@localhost:5432/rysa_db

# Clave secreta para firmar los tokens JWT.
# GENERA LA TUYA con:  openssl rand -hex 32
# JAMÁS uses un valor por defecto ni lo hardcodees.
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET_32_BYTES_HEX>

# Duración de tokens (segundos). Defaults: access 7200 (2h), refresh 1209600 (14d).
# ACCESS_TOKEN_TTL_SECONDS=7200
# REFRESH_TOKEN_TTL_SECONDS=1209600

# Rate limiting de login (on/off). Recomendado siempre "on".
LOGIN_RATE_LIMIT=on

# Orígenes CORS permitidos (separados por coma). Vacío usa los valores por defecto.
# En producción restringir al/los dominio(s) real(es), p. ej. https://gruporysa.com
CORS_ORIGINS=

# Directorio local donde se guardan imágenes y tickets PDF.
# En producción: /var/www/rysa/uploads
UPLOAD_DIR=uploads

# URL pública base del frontend (para enlaces de verificación en tickets/QR).
# PUBLIC_BASE_URL=https://gruporysa.com

# API Key de Facty (https://facty.mx). Tiene prioridad sobre la guardada en
# Configuración de Facturación del ERP. Formato fk_...
FACTY_API_KEY=

# Seed de admin SOLO en desarrollo: se omiten si no existen o si la contraseña
# no tiene al menos 12 caracteres. NUNCA hardcodear valores reales.
ADMIN_EMAIL=<DEV_ADMIN_EMAIL>
ADMIN_PASSWORD=<DEV_ADMIN_PASSWORD_MIN_12_CHARS>
ADMIN_NAME=Admin

# Credenciales sintéticas para la suite de tests (nunca reutilizar las de producción).
TEST_ADMIN_EMAIL=testadmin@rysa-dev.com
TEST_ADMIN_PASSWORD=<TEST_ONLY_PASSWORD_MIN_12_CHARS>
