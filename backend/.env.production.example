# Grupo RYSA backend - Variables PROD (plantilla para el VPS)
# server.py carga backend/.env y, si ENVIRONMENT=production, también backend/.env.production.
# En producción el seed de admin NO se ejecuta automáticamente.
# NUNCA subas secretos reales al repositorio. Rellena en el servidor.

ENVIRONMENT=production
# Módulo desarrollador DESACTIVADO en producción (obligatorio). Aunque un
# atacante consiguiera el rol, las rutas destructivas no existen (404).
DEVELOPER_MODE=false
DATABASE_URL=postgresql+asyncpg://rysa:<real_password>@postgres:5432/rysa_prod

# GENERA con: openssl rand -hex 32  (nunca una clave por defecto)
JWT_SECRET=<GENERATE_A_LONG_RANDOM_SECRET_32_BYTES_HEX>
LOGIN_RATE_LIMIT=on

# En producción restringir a los dominios reales, p. ej. https://gruporysa.com
CORS_ORIGINS=https://gruporysa.com

UPLOAD_DIR=/app/uploads
PUBLIC_BASE_URL=https://gruporysa.com

# API Key de Facty (opcional, si se usa facturación electrónica)
FACTY_API_KEY=
