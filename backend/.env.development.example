# Grupo RYSA backend - Variables DEV (no-Docker / fallback local)
# server.py carga backend/.env y, si ENVIRONMENT=development, también backend/.env.development.
# Copia este archivo a backend/.env.development para desarrollo local sin Docker.
# NUNCA subas secretos reales al repositorio.

ENVIRONMENT=development

# Con Docker, el backend se conecta a PostgreSQL por el servicio 'postgres'.
# Sin Docker, apunta al PostgreSQL local.
DATABASE_URL=postgresql+asyncpg://rysa:change_me@localhost:5432/rysa_dev

JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
LOGIN_RATE_LIMIT=on
CORS_ORIGINS=
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=

# Seed de admin SOLO en desarrollo (mínimo 12 caracteres). NUNCA valores reales.
ADMIN_EMAIL=admin@rysa-dev.local
ADMIN_PASSWORD=CambiaEstaPasswordDev123
ADMIN_NAME=Admin
