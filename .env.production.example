# Grupo RYSA ERP - Plantilla de variables de entorno (producción)
#
# Crea el archivo `.env.docker` (NO lo subas) a partir de esta plantilla.
# NUNCA commitees secretos reales al repositorio.
#
# Valores marcados con <GENERA_CON_OPENSSL> o <CAMBIAR> deben personalizarse
# antes del primer arranque. `scripts/deploy.sh` y `scripts/check_installation.py`
# validan que estos valores no sean los placeholders.

# ──────────── Entorno ────────────
ENVIRONMENT=production

# ──────────── Dominio ────────────
DOMAIN=gruporysa.com
# Producción: false (rutas de /dev/* ni se registran)
DEVELOPER_MODE=false

# ──────────── PostgreSQL ────────────
POSTGRES_USER=rysa
POSTGRES_PASSWORD=<CAMBIAR_GENERAR_CON_openssl_rand_-hex_24>
POSTGRES_DB=rysa

# ──────────── Backend (BD canónica) ────────────
# DATABASE_URL es la variable CANÓNICA que usa la aplicación.
# En producción SIEMPRE debe apuntar a rysa_prod (NO rysa_dev).
# deploy.sh rechaza rysa_dev si ENVIRONMENT=production.
DATABASE_URL=postgresql+asyncpg://rysa:<CAMBIAR_GENERAR_CON_openssl_rand_-hex_24>@postgres:5432/rysa_prod

# BACKEND_DATABASE_URL = DEPRECADA. Conservada por compatibilidad.
# En un sistema nuevo: NO definirla, usar solo DATABASE_URL.
# BACKEND_DATABASE_URL=postgresql+asyncpg://rysa:<PASS>@postgres:5432/rysa_prod

# ──────────── Seguridad / JWT ────────────
JWT_SECRET=<CAMBIAR_GENERAR_CON_openssl_rand_-hex_32>
LOGIN_RATE_LIMIT=on

# ──────────── CORS / Dominios ────────────
# Lista separada por comas con los orígenes que pueden llamar a la API.
# En producción NUNCA uses "*".
CORS_ORIGINS=https://gruporysa.com

# ──────────── Almacenamiento ────────────
UPLOAD_DIR=/app/uploads
PUBLIC_BASE_URL=https://gruporysa.com

# ──────────── Reverse proxy interno (contenedor rysa_nginx) ────────────
# Puerto del host donde escucha el contenedor rysa_nginx. El nginx del
# host hace proxy_pass a este puerto (NO publiques este puerto a internet).
NGINX_HTTP_PORT=8080

# ──────────── Bootstrap admin ────────────
# Creado automáticamente al primer arranque del backend.
# ADMIN_PASSWORD >= 12 caracteres. Cambia este password tras el primer login.
ADMIN_EMAIL=admin@gruporysa.com
ADMIN_PASSWORD=<CAMBIAR_12_O_MAS_CARACTERES>
ADMIN_NAME=Admin

# ──────────── Legacy (migración histórica) ────────────
# En producción: false salvo durante la ventana de migración planificada.
LEGACY_MIGRATION_ENABLED=false
LEGACY_ZIP_MAX_MB=500

# ──────────── Facturación electrónica (opcional) ────────────
FACTY_API_KEY=
