# Grupo RYSA ERP - Plantilla de variables de entorno (producción)
#
# Crea el archivo `.env.docker` (NO lo subas) a partir de esta plantilla.
# NUNCA commitees secretos reales al repositorio.
#
# Valores marcados con <GENERA_CON_OPENSSL> o <CAMBIAR> deben personalizarse
# antes del primer arranque. `scripts/deploy.sh` y `scripts/check_installation.py`
# validan que estos valores no sean los placeholders.

# ──────────── Entorno ────────────
# development | staging | production
ENVIRONMENT=production

# ──────────── PostgreSQL ────────────
POSTGRES_USER=rysa
POSTGRES_PASSWORD=<CAMBIAR_GENERAR_CON_openssl_rand_-hex_24>
POSTGRES_DB=rysa
# URL interna (dentro de Docker, el host es el nombre del servicio `postgres`).
BACKEND_DATABASE_URL=postgresql+asyncpg://rysa:<CAMBIAR_GENERAR_CON_openssl_rand_-hex_24>@postgres:5432/rysa_dev

# ──────────── Seguridad / JWT ────────────
# 32 bytes hex = 64 caracteres. CAMBIAR siempre. Si lo dejas vacío o
# placeholder, el check_installation.py fallará al validar.
JWT_SECRET=<CAMBIAR_GENERAR_CON_openssl_rand_-hex_32>
LOGIN_RATE_LIMIT=on

# ──────────── CORS / Dominios ────────────
# Lista separada por comas con los orígenes que pueden llamar a la API.
# En producción NUNCA uses "*".
CORS_ORIGINS=https://tu-dominio.com

# ──────────── Almacenamiento ────────────
UPLOAD_DIR=/app/uploads
PUBLIC_BASE_URL=https://tu-dominio.com

# ──────────── Nginx ────────────
# Puerto expuesto por el contenedor rysa_nginx (host:contenedor).
NGINX_HTTP_PORT=8080

# ──────────── Módulo Legacy (migración histórica) ────────────
# Habilita el subsistema de import del histórico. En producción DEBE ser
# false salvo durante una ventana de migración planificada.
DEVELOPER_MODE=false
LEGACY_MIGRATION_ENABLED=false
# Tamaño máximo del ZIP que aceptará el endpoint /legacy/data/deploy.
# Ajustar si tu ZIP es más grande (el nginx ya está en 350m).
LEGACY_ZIP_MAX_MB=500

# ──────────── Bootstrap admin ────────────
# En PRODUCTION el seed de admin NO se ejecuta automáticamente. Crea el
# admin manualmente tras el primer arranque (ver DEPLOY_VPS.md sección 6).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ──────────── Facturación electrónica (opcional) ────────────
FACTY_API_KEY=
