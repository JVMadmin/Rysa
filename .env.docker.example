# ---------------------------------------------------------------
# Grupo RYSA ERP - Plantilla de entorno DOCKER (DEV)
# Usos:
#   cp .env.docker.example .env          -> variables para interpolación de docker-compose
#   cp .env.docker.example .env.docker    -> env_file del contenedor backend
# NUNCA subas secretos reales al repositorio. Cambia TODOS los valores por defecto.
# ---------------------------------------------------------------

# --- Entorno ---
ENVIRONMENT=development

# --- PostgreSQL (imagen postgres:17) ---
# Credenciales del superusuario de la instancia PostgreSQL.
POSTGRES_USER=rysa
POSTGRES_PASSWORD=rysa_dev_only_change_me
# Base "primaria" (se crean además rysa_dev y rysa_prod vía init script)
POSTGRES_DB=rysa

# --- Backend ---
# URL a la que se conecta el backend DEV (host = nombre de servicio Docker 'postgres')
BACKEND_DATABASE_URL=postgresql+asyncpg://rysa:rysa_dev_only_change_me@postgres:5432/rysa_dev

# Clave para firmar JWT. GENERA UNA NUEVA con:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# TTLs de tokens (segundos). Defaults: access 7200 (2h), refresh 1209600 (14d).
# ACCESS_TOKEN_TTL_SECONDS=7200
# REFRESH_TOKEN_TTL_SECONDS=1209600

# Rate limiting de login
LOGIN_RATE_LIMIT=on

# CORS: en DEV detrás de Nginx todo es mismo origen, vacío usa defaults (localhost:3000/5173)
CORS_ORIGINS=

# Directorio de uploads dentro del contenedor (montado como volumen persistente rysa_uploads)
UPLOAD_DIR=/app/uploads

# URL pública base (para enlaces de verificación en tickets/QR). Vacío en DEV local.
PUBLIC_BASE_URL=

# Seed de admin SOLO en desarrollo (mínimo 12 caracteres). NUNCA valores reales.
ADMIN_EMAIL=admin@rysa-dev.local
ADMIN_PASSWORD=CambiaEstaPasswordDev123
ADMIN_NAME=Admin

# --- HTTP externo ---
# Puerto del host donde Nginx publica el sistema (solo Nginx se publica).
NGINX_HTTP_PORT=8080
