# ---------------------------------------------------------------
# Grupo RYSA ERP - Plantilla de entorno DOCKER
# Usos:
#   cp .env.docker.example .env.docker
# NUNCA subas secretos reales al repositorio. Cambia TODOS los valores por defecto.
# En producción, ejecuta `deploy.sh` que valida este archivo antes de levantar.
# ---------------------------------------------------------------

# --- Entorno ---
# development | production
ENVIRONMENT=development

# Módulo DESARROLLADOR (limpieza de datos de prueba). true solo en DEV;
# en producción usar false (las rutas destructivas no se registran).
DEVELOPER_MODE=true

# --- Dominio público ---
# En producción: tu dominio apuntando al VPS (ej. gruporysa.com).
# Vacío = entorno local sin HTTPS (no se valida dominio en check).
DOMAIN=

# --- PostgreSQL (imagen postgres:17) ---
# Credenciales del superusuario de la instancia PostgreSQL.
POSTGRES_USER=rysa
# Genera con: openssl rand -hex 24
POSTGRES_PASSWORD=rysa_dev_only_change_me
POSTGRES_DB=rysa

# --- Backend ---
# URL a la que se conecta el backend (host = nombre de servicio Docker 'postgres')
BACKEND_DATABASE_URL=postgresql+asyncpg://rysa:rysa_dev_only_change_me@postgres:5432/rysa_dev

# Clave para firmar JWT. GENERA con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# TTLs de tokens (segundos). Defaults: access 7200 (2h), refresh 1209600 (14d).
# ACCESS_TOKEN_TTL_SECONDS=7200
# REFRESH_TOKEN_TTL_SECONDS=1209600

# Rate limiting de login
LOGIN_RATE_LIMIT=on

# CORS: lista separada por comas. Vacío en dev detrás de Traefik.
CORS_ORIGINS=

# Directorio de uploads dentro del contenedor (volumen persistente)
UPLOAD_DIR=/app/uploads

# URL pública base (para enlaces de verificación en tickets/QR).
# En production: https://${DOMAIN}
PUBLIC_BASE_URL=

# --- Bootstrap del primer administrador ---
# Se ejecuta al arrancar el contenedor `backend` antes de uvicorn.
# Idempotente: si el admin ya existe, actualiza su password y rol.
# En production es OBLIGATORIO. ADMIN_PASSWORD >= 12 caracteres, NUNCA hardcoded.
ADMIN_EMAIL=admin@rysa-dev.local
ADMIN_PASSWORD=CambiaEstaPasswordDev123
ADMIN_NAME=Admin

# --- Legacy (migración histórica) ---
# Habilita el subsistema de import. true en dev/staging; false en producción.
LEGACY_MIGRATION_ENABLED=false
# Tamaño máximo (MB) del ZIP que aceptará /api/legacy/data/deploy.
LEGACY_ZIP_MAX_MB=500
