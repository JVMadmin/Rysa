# ============================================================
# RYSA Consultor de Precios - Frontend (dev local)
# Copia este archivo como .env.local (nunca se commitea).
# ============================================================

# API del Consultor (dev). Con Docker se compila con ruta relativa
# (mismo origen) y esta variable no hace falta.
REACT_APP_PRICE_API_URL=http://127.0.0.1:8040

# Origen del ERP para resolver imagenes de producto guardadas con ruta
# relativa (p. ej. /api/files/...). En produccion apunta a erp.gruporysa.com.
REACT_APP_IMG_BASE=http://127.0.0.1:8030

# Nombre de sucursal a mostrar en el encabezado (opcional).
REACT_APP_SUCURSAL=Sucursal Centro

# ============================================================
# MODO PRUEBA LOCAL (NO requiere base de datos)
# Activa datos ficticios estilo RYSA para probar la interfaz
# sin levantar backend ni PostgreSQL. Desactiva para conexión real.
# ============================================================
REACT_APP_MOCK=1