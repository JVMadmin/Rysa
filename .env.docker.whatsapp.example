# ==================================================================
# RYSA WhatsApp (WAHA) - variables de entorno
# Copia como .env.docker.whatsapp y pon valores aleatorios largos:
#   openssl rand -hex 32
# Los mismos dos valores van en .env.docker del backend:
#   WAHA_URL=http://rysa_waha:3000
#   WAHA_API_KEY=<igual que abajo>
#   WAHA_HMAC_KEY=<igual que abajo>
# ==================================================================
WAHA_API_KEY=
WAHA_HMAC_KEY=
# Etiqueta de la imagen devlikeapro/waha (gows = motor sin navegador)
WAHA_TAG=gows
